NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=sinpe_app
DB_PASSWORD=
DB_NAME=sinpe_movil
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
APP_USER=admin
# Generate with: npm run hash-password
APP_PASSWORD_HASH=
# Respaldos (backup module). sinpe_app cannot dump or restore, so these use an account with every
# privilege on the database (root works). Leave BACKUP_DB_USER empty to turn the module off.
BACKUP_DB_USER=root
BACKUP_DB_PASSWORD=
# Folder with mysqldump.exe and mysql.exe (empty if they are on the PATH)
MYSQL_BIN_DIR=C:\Program Files\MySQL\MySQL Server 8.0\bin
# Where backups, the schedule and the history are saved (relative to the project or absolute)
BACKUP_DIR=respaldos
